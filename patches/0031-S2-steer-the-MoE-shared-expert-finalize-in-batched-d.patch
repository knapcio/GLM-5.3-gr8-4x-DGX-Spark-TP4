-        }
-        if (y.L[M].heads != y.ab.args.heads) die("kernel binder and attention binder disagree on the head count");
-        qs_narrow(m, i, y.L[M]);
-#ifdef DEC_SLOT
-        // DEC_SLOT: o_proj and the K1 finalize / dense fc2 write the partial into the send slot (decslot.cuh)
