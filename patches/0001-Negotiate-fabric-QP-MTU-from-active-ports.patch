diff --git a/engine/comms/fabric_mtu.h b/engine/comms/fabric_mtu.h
new file mode 100644
index 0000000..e112fb8
--- /dev/null
+++ b/engine/comms/fabric_mtu.h
@@ -0,0 +1,7 @@
+// ibv_mtu wire values: 1..5 represent 256..4096 bytes; reject invalid bootstrap metadata.
+#pragma once
+#include <cstdint>
+namespace g6 {
+constexpr bool valid_fabric_mtu(uint32_t mtu) { return mtu >= 1 && mtu <= 5; }
+constexpr uint32_t fabric_mtu_min(uint32_t local, uint32_t peer) { return local < peer ? local : peer; }
+}
diff --git a/engine/comms/fabric_mtu_test.cpp b/engine/comms/fabric_mtu_test.cpp
new file mode 100644
index 0000000..c740539
--- /dev/null
+++ b/engine/comms/fabric_mtu_test.cpp
@@ -0,0 +1,16 @@
+#include "fabric_mtu.h"
+#include <cassert>
+#include <cstdio>
+int main() {
+    using namespace g6;
+    for (uint32_t a = 1; a <= 5; ++a) for (uint32_t b = 1; b <= 5; ++b) {
+        assert(valid_fabric_mtu(a) && valid_fabric_mtu(b));
+        const auto mtu = fabric_mtu_min(a, b);
+        assert(mtu <= a && mtu <= b && valid_fabric_mtu(mtu));
+        assert(mtu == fabric_mtu_min(b, a));
+    }
+    assert(!valid_fabric_mtu(0) && !valid_fabric_mtu(6));
+    assert(!valid_fabric_mtu(1024) && !valid_fabric_mtu(UINT32_MAX));
+    assert(fabric_mtu_min(3, 5) == 3 && fabric_mtu_min(5, 3) == 3);
+    std::puts("fabric MTU: 25 endpoint pairs, invalid wire values and 1024/4096 regression PASS");
+}
