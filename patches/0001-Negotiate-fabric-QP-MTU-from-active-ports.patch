-struct QPInfo { uint32_t qpn, psn, rkey; uint64_t addr; uint8_t gid[16]; };
-struct Rail { DevInfo di; ibv_context* ctx = nullptr; ibv_pd* pd = nullptr; ibv_cq* cq = nullptr; ibv_mr* mr = nullptr; ibv_gid gid{}; };
+struct QPInfo { uint32_t qpn, psn, rkey; uint64_t addr; uint8_t gid[16]; uint32_t mtu; };
+struct Rail { DevInfo di; ibv_context* ctx = nullptr; ibv_pd* pd = nullptr; ibv_cq* cq = nullptr; ibv_mr* mr = nullptr; ibv_gid gid{}; ibv_mtu mtu{}; };
+
+// The bootstrap carries the active port MTU with each QP. All ranks must use this wire format.
+void read_rail_mtu(Rail& R, int rail, int port) {
+  ibv_port_attr attr{};
+  FCHECK(ibv_query_port(R.ctx, 1, &attr) == 0);
+  FCHECK(attr.state == IBV_PORT_ACTIVE && valid_fabric_mtu(attr.active_mtu));
+  R.mtu = attr.active_mtu;
+  fprintf(stderr, "[fabric r%d port %d] rail %d device %s netdev %s gid %d active_mtu %u bytes\n",
+          g_rank, port, rail, R.di.dev.c_str(), R.di.netdev.c_str(), R.di.gid_index, 128u << unsigned(R.mtu));
+}
+ibv_mtu connection_mtu(const Rail& R, const QPInfo& peer) {
+  FCHECK(valid_fabric_mtu(R.mtu) && valid_fabric_mtu(peer.mtu));
+  return static_cast<ibv_mtu>(fabric_mtu_min(R.mtu, peer.mtu));
+}
+void check_qp_mtu(ibv_qp* qp, const Rail& R, const QPInfo& peer, ibv_mtu selected, int port) {
+  ibv_qp_attr attr{}; ibv_qp_init_attr init{};
+  FCHECK(ibv_query_qp(qp, &attr, IBV_QP_STATE | IBV_QP_PATH_MTU | IBV_QP_AV, &init) == 0);
+  FCHECK(attr.qp_state == IBV_QPS_RTS && attr.path_mtu == selected);
+  fprintf(stderr, "[fabric r%d port %d] QP %u -> %u device %s gid %d MTU local %u peer %u selected %u effective %u bytes\n",
+          g_rank, port, qp->qp_num, peer.qpn, R.di.dev.c_str(), R.di.gid_index,
+          128u << unsigned(R.mtu), 128u << peer.mtu, 128u << unsigned(selected), 128u << unsigned(attr.path_mtu));
+}
 
 // ---- switchless ring (FabricConfig::ring) ---------------------------------------------------------------------------
 // Ranks sit on a cable ring: port f0 of rank r is cabled to port f1 of rank r+1, and each port shows up as two RDMA
@@ -413,6 +436,7 @@ void Fabric::init(const FabricConfig& cfg) {
