From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: knapcio <knapcio@gmail.com>
Date: Sun, 18 Oct 2026 03:27:10 +0200
Subject: [PATCH 15/31] S2: capture every DFlash2 first-form width, bound step
 rows and the acceptance histogram by the drafter verify width

---
 engine/runtime/g6m4.cu       | 14 ++++++++------
 engine/runtime/s2/sessions.h |  2 +-
 engine/runtime/s2_batch.h    |  4 ++--
 3 files changed, 11 insertions(+), 9 deletions(-)

diff --git a/engine/runtime/g6m4.cu b/engine/runtime/g6m4.cu
index 17cbc67..4617102 100644
--- a/engine/runtime/g6m4.cu
+++ b/engine/runtime/g6m4.cu
@@ -297,7 +297,7 @@ int main(int argc, char** argv)
         if (!kstop.mode) kstop.kmax = 0;
         // G6_MTP_KSTOPB=1 (s2_batch.h KStopB; default 0): in shared rounds each session verifies its own k_q of the K
         // drafts: the most j with p_1 * .. * p_i >= t_i for every i <= j, at least G6_MTP_KSTOPB_KMIN (0|1, default 0).
-        // G6_MTP_KSTOPB_TAU=t1[,t2[,t3]] (default 0.6,0.88) at every session count, G6_MTP_KSTOPB_TAU_S<n> at n sessions.
+        // G6_MTP_KSTOPB_TAU=t1[,t2[,...]] (default 0.6,0.88; past the last entry there is no stop - the remaining drafts all verify) at every session count, G6_MTP_KSTOPB_TAU_S<n> at n sessions.
         // G6_MTP_KSTOPB_WIDTHS=M,..: the main widths captured besides the multiples of K + 1 (default every width the rule reaches;
         // a width outside them takes the next most likely drafts). G6_MTP_KSTOPB_EXPLORE=n (measurement): every n-th
         // round's shared sessions verify a hashed k_q instead. In the S2 runtime signature
@@ -319,13 +319,13 @@ int main(int argc, char** argv)
             }
             return t;
         };
-        double bt[4] = {0, 0.6, 0.88, 0.95};
-        if (getenv("G6_MTP_KSTOPB_TAU")) { const auto t = nums("G6_MTP_KSTOPB_TAU", 3); std::copy(t.begin(), t.end(), bt + 1); }
+        double bt[8] = {0, 0.6, 0.88, 0.95, 0, 0, 0, 0};   // past the configured entries there is no stop: the remaining drafts all verify (tau = 0)
+        if (getenv("G6_MTP_KSTOPB_TAU")) { const auto t = nums("G6_MTP_KSTOPB_TAU", 7); std::copy(t.begin(), t.end(), bt + 1); }
         for (int S = 1; S <= s2::S2N_SLOTS; ++S)
         {
-            std::copy(bt, bt + 4, kstop.b.tau[S]);
+            std::copy(bt, bt + 8, kstop.b.tau[S]);
             const std::string n = "G6_MTP_KSTOPB_TAU_S" + std::to_string(S);
-            if (getenv(n.c_str())) { const auto t = nums(n.c_str(), 3); std::copy(t.begin(), t.end(), kstop.b.tau[S] + 1); }
+            if (getenv(n.c_str())) { const auto t = nums(n.c_str(), 7); std::copy(t.begin(), t.end(), kstop.b.tau[S] + 1); }
         }
         if (getenv("G6_MTP_KSTOPB_WIDTHS"))
             for (double w : nums("G6_MTP_KSTOPB_WIDTHS", 64))
@@ -397,6 +397,7 @@ int main(int argc, char** argv)
         if (std::find(row_counts.begin(), row_counts.end(), mtp + 1) == row_counts.end()) row_counts.push_back(mtp + 1);
     }
     if (dfl && std::find(row_counts.begin(), row_counts.end(), dfl_k + 1) == row_counts.end()) row_counts.push_back(dfl_k + 1);
+    if (dfl) for (int M = 1; M <= dfl_k + 1; ++M) if (std::find(draft_rows.begin(), draft_rows.end(), M) == draft_rows.end()) draft_rows.push_back(M);   // first-form: accepted-prefix a (0..dfl_k) -> M = a + 1
     for (int M = 2; M <= kstop.kmax + 1; ++M)   // G6_MTP_KSTOP: solo MTP verifies of 2..kmax + 1 rows, first forms of as many
     {
         if (std::find(row_counts.begin(), row_counts.end(), M) == row_counts.end()) row_counts.push_back(M);
@@ -979,7 +980,8 @@ int main(int argc, char** argv)
         sc.epoch = s2epoch;
         sc.pool_rows = (uint32_t)(cap / 64 * 64);
         // one step bounds: a round (every session's mtp + 1 rows) and a prompt chunk (sessions.h: chunk <= max_rows)
-        sc.max_rows = std::min<uint32_t>(MX, std::max<uint32_t>((uint32_t)s2sess * (uint32_t)(mtp + 1), (uint32_t)plan.chunk));
+        // one step bounds: a round (every session's mtp + 1 rows), a prompt chunk (sessions.h: chunk <= max_rows) and the DFlash2 verify width
+        sc.max_rows = std::min<uint32_t>(MX, std::max<uint32_t>({(uint32_t)s2sess * (uint32_t)(mtp + 1), (uint32_t)plan.chunk, dfl ? (uint32_t)(dfl_k + 1) : 0u}));
         sc.max_sessions = (uint32_t)s2sess;
         sc.mtp = (uint32_t)mtp;
         if (dfl) sc.guard_tokens = 2 * dfl::K;     // a DFlash2 verify writes up to 7 rows past the last token, as the offline loop's cap rule
diff --git a/engine/runtime/s2/sessions.h b/engine/runtime/s2/sessions.h
index f0c5283..fe25568 100644
--- a/engine/runtime/s2/sessions.h
+++ b/engine/runtime/s2/sessions.h
@@ -146,7 +146,7 @@ public:
         auto& s = get(k); if (s.ended) return;
         // Emitter::end uses per-request counters here, never process-wide totals.
         // K + 1 bins: K = the MTP draft count, or 7 for a session that started on DFlash2 (s2_batch.h)
-        require(stats.acc.empty() || (stats.acc.size() >= config_.mtp + 1 && stats.acc.size() <= 8), "bad per-request acceptance histogram");
+        require(stats.acc.empty() || (stats.acc.size() >= config_.mtp + 1 && stats.acc.size() <= 16), "bad per-request acceptance histogram");
         std::array<long, 8> zero{};
         auto& em = s.emitter;
         if (em.f) {
diff --git a/engine/runtime/s2_batch.h b/engine/runtime/s2_batch.h
index e3e7896..27a9779 100644
--- a/engine/runtime/s2_batch.h
+++ b/engine/runtime/s2_batch.h
@@ -342,7 +342,7 @@ struct KStopB
 {
     int mode = 0;
     int kmin = 0;
-    double tau[S2N_SLOTS + 1][4] = {};    // [S][j]
+    double tau[S2N_SLOTS + 1][8] = {};    // [S][j]; j past the configured entries is 0 (the remaining drafts all verify)
     std::vector<int> widths;          // main widths captured besides the multiples of K + 1; empty: every width
     int explore = 0;
     // whether a shared round of S sessions may launch a main step of M rows (K: the MTP drafts)
@@ -368,7 +368,7 @@ inline std::string kstopb_sig(const KStopB& b)
     std::string s = " kstopb " + std::to_string(b.mode) + " kmin " + std::to_string(b.kmin) + " tau";
     char t[32];
     for (int S = 1; S <= S2N_SLOTS; ++S)
-        for (int j = 1; j <= 3; ++j) { snprintf(t, sizeof t, "%s%.17g", S == 1 && j == 1 ? " " : j == 1 ? "/" : ",", b.tau[S][j]); s += t; }
+        for (int j = 1; j <= 7; ++j) { snprintf(t, sizeof t, "%s%.17g", S == 1 && j == 1 ? " " : j == 1 ? "/" : ",", b.tau[S][j]); s += t; }
     s += " widths";
     for (size_t i = 0; i < b.widths.size(); ++i) s += (i ? "," : " ") + std::to_string(b.widths[i]);
     return s + " explore " + std::to_string(b.explore);
