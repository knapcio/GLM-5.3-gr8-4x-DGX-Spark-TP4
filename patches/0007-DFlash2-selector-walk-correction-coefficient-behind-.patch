From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: knapcio <knapcio@gmail.com>
Date: Thu, 15 Oct 2026 08:15:31 +0200
Subject: [PATCH 07/30] DFlash2 selector walk: correction coefficient behind
 G6_DFL_SEL_ALPHA

score = logit + alpha * correction; the draft lp follows the new scores. Drafts
only, the verify is unchanged. Default 1 gives the same bits (1 * x is exact).
---
 docs/SETTINGS.md          | 1 +
 engine/runtime/dflash.cuh | 8 +++++---
 engine/runtime/g6m4.cu    | 9 ++++++++-
 3 files changed, 14 insertions(+), 4 deletions(-)

diff --git a/docs/SETTINGS.md b/docs/SETTINGS.md
index 094bf51..d809a95 100644
--- a/docs/SETTINGS.md
+++ b/docs/SETTINGS.md
@@ -89,6 +89,7 @@ the short version.
 | `G6_MTP_SPLIT` | 0 | MTP draft steps (needs `--mtp`): eh_proj (6144 outputs, 78 MB replicated), then layer 78's q_a / kv_a / indexer k and weights (as `G6_QA_SPLIT=1`) and idx_q (as `G6_IDXQ_SPLIT=1`), split by output tiles and gathered on a draft gather fabric (port + 72). Same bits as 0 |
 | `G6_DRAFT_HEAD_I4` | 0 | MTP draft steps (needs `--mtp`): the draft's lm_head GEMV reads INT4 g32 records of the rank's vocab slice, made at boot on the GPU from its MXFP8 records (134 MB more per rank at TP4), instead of the MXFP8 records: 45% fewer head bytes per draft step. The target's head and the verify steps are unchanged, so the committed tokens are the target's; drafts (and their log-probabilities, which `--spec-adaptive` reads) can differ from the MXFP8 head's (offline, E9 held-out: first-draft acceptance -0.07 pt [-0.32, +0.17]). Same on every rank. `G6_DRAFT_HEAD_KS` (32, 2..32) / `G6_DRAFT_HEAD_TPC` (1) = the GEMV's k parts per tile and tiles per CTA; every rank must set the same values |
 | `G6_DFL_HEAD_I4` | 0 | DFlash2 drafter (needs `--dflash-manifest`): its lm_head GEMV reads the same INT4 g32 records as `G6_DRAFT_HEAD_I4` (the MTP draft's copy when that is on, else one made the same way; same `G6_DRAFT_HEAD_KS` / `_TPC`). In selector mode the head's raw logits choose each row's top-16 candidates and enter their walk scores, so INT4 can change both. The target's head and the verify steps are unchanged. Every rank must set the same value |
+| `G6_DFL_SEL_ALPHA` | 1 | DFlash2 selector walk (needs `--dflash-manifest` and the selector): each candidate scores `logit + a * correction` instead of `logit + correction`, and the draft's log-probability comes from those scores. Drafts only; the verify is unchanged. Every rank must set the same value |
 | `G6_GV_MULTI` | 1 | steps of up to 8 rows run the GEMVs on the layer input (q_a, kv_a, the indexer's k and weights) as one launch; 0 = one launch each (same bits) |
 | `G6_S2_ADAPT` | 0 | S2: choose each round's MTP draft count (1..k) from the sessions' accept rates and the S2 step costs; 1 adds ~1 GiB of main-step graphs |
 | `G6_S2_GROW` | 1 | S2: a session below R holds the KV pages it needs now and takes more as its output grows, admitted and grown only while every live session can still reach prompt + `max_tokens` + guard; a session that cannot grow sits out rounds. 0 = every run holds that worst case from admission |
diff --git a/engine/runtime/dflash.cuh b/engine/runtime/dflash.cuh
index 9798b05..d15840b 100644
--- a/engine/runtime/dflash.cuh
+++ b/engine/runtime/dflash.cuh
@@ -79,6 +79,7 @@ struct Dfl
 {
     int rank = -1;
     bool sel = false;                 // DFlash2 selector walk (else argmax / gr8's sampler)
+    float sel_alpha = 1.f;            // G6_DFL_SEL_ALPHA: the walk's correction coefficient (draft tokens and lp only)
     int mask_id = 0;
     float theta = 1e6f, eps = 1e-5f;
     int tlayer[dfl::NT] = {};         // target_layer_ids
@@ -416,7 +417,7 @@ __global__ void __launch_bounds__(1024) k_top_local(TopArgs a)
     glue::publish(a.f, a.c, g6::coll_seq(*a.stepp, a.c, a.f.ncoll), a.ticket);
 }
 // merge every rank's candidates -> global top-16 per row, then the walk, with prev = the bonus token at s = 1:
-//   score(c) = logit(c) + sum_i pred[prev][i] hp[s][i] succ[c][i]
+//   score(c) = logit(c) + alpha * sum_i pred[prev][i] hp[s][i] succ[c][i]   (alpha = Dfl::sel_alpha, 1 by default)
 //   pick = argmax of score * inv_temp + gumbel(row s's key, c), or of score when greedy
 //   prev = pick, s = s + 1, up to s = 7. lp_out = log-probability of the pick in softmax(score) over the 16
 // grid 1, block 256. Warp w < 7 merges row w + 1, then warp w scores candidates w and w + 8.
@@ -429,6 +430,7 @@ struct WalkArgs
     const glue::SampleRow* srow;
     int* tok_out;
     float* lp_out;
+    float alpha;                      // the correction's coefficient (1: the trained selector, exactly)
 };
 __global__ void __launch_bounds__(256) k_walk(WalkArgs a)
 {
@@ -472,7 +474,7 @@ __global__ void __launch_bounds__(256) k_walk(WalkArgs a)
                 acc += __bfloat162float(a.pred[(size_t)prev * SELR + i]) * hp[i] * __bfloat162float(a.succ[(size_t)id * SELR + i]);
             #pragma unroll
             for (int o = 16; o > 0; o >>= 1) acc += __shfl_xor_sync(0xffffffffu, acc, o);
-            if (l == 0) s_sc[cc] = s_l[s][cc] + acc;
+            if (l == 0) s_sc[cc] = s_l[s][cc] + a.alpha * acc;
         }
         __syncthreads();
         if (t == 0)
@@ -853,7 +855,7 @@ inline void dfl_phase(Dfl& D, int p, cudaStream_t st, bool query = true)
     }
     // p == NC: the merge (gr8's head merge in argmax mode, the walk in selector mode), StepOut
     if (D.sel)
-        dflk::k_walk<<<1, 256, 0, st>>>(dflk::WalkArgs{D.f, D.stepp, NC - 1, D.hp, D.pred, D.succ, D.tok, D.srow, D.tok_out, D.lp});
+        dflk::k_walk<<<1, 256, 0, st>>>(dflk::WalkArgs{D.f, D.stepp, NC - 1, D.hp, D.pred, D.succ, D.tok, D.srow, D.tok_out, D.lp, D.sel_alpha});
     else if (D.nc > 0) glue::k_head_merge_tp<<<B, 1024, 0, st>>>(dfl_head_args(D));
     else glue::k_head_merge<<<1, 32, 0, st>>>(dfl_head_args(D));
     dflk::k_out<<<1, 32, 0, st>>>(dflk::OutArgs{D.tok_out, D.lp, D.out});
diff --git a/engine/runtime/g6m4.cu b/engine/runtime/g6m4.cu
