From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: knapcio <knapcio@gmail.com>
Date: Sun, 18 Oct 2026 19:47:19 +0200
Subject: [PATCH 39/39] kvb8_test: the recipe's ABS2 (1/2/4/8) and VP2 (1/2/4)
 widths, alone and under QT; the QT bench call on the recipe's launcher

---
 engine/runtime/tests/kvb8_test.cu | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/engine/runtime/tests/kvb8_test.cu b/engine/runtime/tests/kvb8_test.cu
index 6953032..91916b5 100644
--- a/engine/runtime/tests/kvb8_test.cu
+++ b/engine/runtime/tests/kvb8_test.cu
@@ -158,6 +158,16 @@ int main(int argc, char** argv)
             both("decode", decode);
             ga::avp1_on() = 1; both("decode G6_AVP1", decode); ga::avp1_on() = 0;
             ga::attn_qt() = 1; ga::attn_sc2() = 4; both("decode G6_ATTN_QT", decode); ga::attn_qt() = 0; ga::attn_sc2() = 0;
+            // the recipe's absorb_m2 / value_project_m2 widths (G6_ATTN_ABS2 = 1/2/4/8, G6_ATTN_VP2 = 1/2/4), alone and under QT
+            for (int q = 0; q < 2; ++q)
+            {
+                ga::attn_qt() = q; ga::attn_sc2() = q ? 4 : 0;
+                for (int R : {1, 2, 4, 8}) { char n[64]; snprintf(n, sizeof n, "decode%s G6_ATTN_ABS2=%d", q ? " QT" : "", R); ga::attn_abs2() = R; both(n, decode); }
+                ga::attn_abs2() = 0;
+                for (int R : {1, 2, 4}) { char n[64]; snprintf(n, sizeof n, "decode%s G6_ATTN_VP2=%d", q ? " QT" : "", R); ga::attn_vp2() = R; both(n, decode); }
+                ga::attn_vp2() = 0;
+            }
+            ga::attn_qt() = 0; ga::attn_sc2() = 0;
             G6AttnPrefill *fb = nullptr, *f8 = nullptr;
             CKI(g6_attn_bind_prefill_create(&fb, &bb, nullptr));
             CKI(g6_attn_bind_prefill_create(&f8, &b8, nullptr));
@@ -218,7 +228,7 @@ int main(int argc, char** argv)
                 ga::Work w{}; w.q = q; w.rope = rope; w.context = ctx;
                 t[k][0] = timed([&] { ga::launch_absorb_m(a, a, w, 0, M, nullptr); });
                 t[k][1] = timed([&] { ga::launch_value_project_m(a, a, w, 0, M, nullptr); });
-                t[k][2] = timed([&] { ga::launch_absorb_m2(a, a, w, 0, M, nullptr); });
+                t[k][2] = timed([&] { ga::launch_absorb_m2(a, a, w, 0, M, 1, true, nullptr); });
                 CK(cudaGetLastError());
             }
             const float saved = t[0][0] + t[0][1] - t[1][0] - t[1][1];
