+static void time_dfl(int reps)
+{
+    const size_t L2SET = 96u << 20;   // > 25 MB L2: each launch reads records the previous ones evicted
+    double tot_mx = 0, tot_i4 = 0;
+    __half* dx;
+    u32* xf;
+    void* dy;
