+    CK(cudaMemset(dx, 0x31, (size_t)8 * 36864 * 2));
+    CK(cudaMalloc(&xf, (size_t)36864 / 16 * 64 * 4 * g6mx::NT));
+    CK(cudaMalloc(&dy, (size_t)8 * 6144 * 4));
