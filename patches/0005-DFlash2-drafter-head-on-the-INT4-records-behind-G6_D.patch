--- a/engine/runtime/rank.cuh
+++ b/engine/runtime/rank.cuh
@@ -1542,28 +1542,35 @@ inline DraftHeadI4 draft_head_i4_env()
     if (c.tpc * c.ks > 32) die("G6_DRAFT_HEAD_TPC x G6_DRAFT_HEAD_KS must be <= 32 (warps of one CTA)");
