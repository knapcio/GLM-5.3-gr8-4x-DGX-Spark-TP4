diff --git a/engine/kernels/tests/ar_fold_test.cu b/engine/kernels/tests/ar_fold_test.cu
new file mode 100644
index 0000000..9586b39
--- /dev/null
+++ b/engine/kernels/tests/ar_fold_test.cu
@@ -0,0 +1,365 @@
+// ar_fold_test: G6_AR_WAITFOLD (glue.cuh k_ar_wait_add_norm<1|2>, the wait for the peers' partials folded into the
+// all-reduce consume) against the split pair the engine launches today (k_wait_peers, then k_ar_add_norm). One GB10, no
+// pack files, no NIC: rank 0 of a G6_NR-rank fabric whose slots are pinned host memory, as the real fabric's are. A chain
+// of 2 x layers consumes (collectives 0.., each its own slots, norm weight and outputs, the residual carried through), as
+// rank.cuh launch_step runs them.
+//
+//   ar_fold_test [--M 1,3,4,8] [--layers 78] [--reps 50] [--gap-us 20] [--check-only] [--bench-only]
+//
+// Check (the claim: same bytes out): per M, the residual after the chain, every consume's normed rows and (DEC_SLOT)
+// fragment tables of fold 1 and fold 2 == split, byte for byte:
+//   ready  every peer's payload and tail are in place before the chain starts;
+//   late   the peers' slots start as 0xff (NaN payload, no tail); a writer kernel on another stream fills them one
+//          collective at a time, gap-us apart (payload, system fence, then the tails with st.release.sys, as the proxy's
+//          RDMA writes land payload first): every consume has to wait, and a payload read before its tail would show.
+// Bench (idle GPU): ready: a CUDA graph of the chain, reps launches per sample, median of 5 interleaved samples:
+// us per consume, and the step's saving (x 2 x layers). late: per consume, the time from the writer's last tail store
+// to the end of the reduce (the XTRACE stamp k_ar_add_norm writes), mean and median over the chain: what the fold
+// changes after the last peer's partial lands, the case decode is in.
+// Exit code: 0 all PASS, 1 any FAIL, 2 CUDA error / usage.
+//
+// Build (from engine/kernels/tests, the engine's K1H2 flags as scripts/build.sh sets them):
+//   eval "$(sed -n '/^K1H2_FLAGS=/,/"$/p' ../../../scripts/build.sh)"
+//   nvcc -O3 -std=c++17 -gencode=arch=compute_121a,code=sm_121a $K1H2_FLAGS -DG6_NR=4 -DDEC_S2 -Xptxas -v \
+//     -o ar_fold_test ar_fold_test.cu
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+#include <cuda_runtime.h>
+#include "../glue.cuh"
+
+#define CK(x)                                                                                                   \
+    do                                                                                                          \
+    {                                                                                                           \
+        const cudaError_t e_ = (x);                                                                             \
+        if (e_ != cudaSuccess)                                                                                  \
+        {                                                                                                       \
+            printf("CUDA error %s at %s:%d: %s\n", #x, __FILE__, __LINE__, cudaGetErrorString(e_));             \
+            exit(2);                                                                                            \
+        }                                                                                                       \
+    } while (0)
+
+constexpr int NR = g6nr::NR;
+constexpr int MXR = g6mx::MX;
+constexpr u64 STEP = 1;
+constexpr int XFW = KSH * 16 * 4;        // u32 words of one n=8 tile's fragment table
+
+// the peers' partials of every collective, landed one collective at a time gap_ns apart: payload, system fence, tails
+__global__ void __launch_bounds__(256) k_writer(g6::FabricDev f, int M, const char* stage, unsigned long long delay_ns,
+                                                unsigned long long gap_ns, unsigned long long* rel)
+{
+    __shared__ unsigned long long t0;
+    if (threadIdx.x == 0) t0 = glue::xt_now();
+    __syncthreads();
+    const size_t bytes = (size_t)M * HID * 2;
+    for (int c = 0; c < f.ncoll; ++c)
+    {
+        if (threadIdx.x == 0) while (glue::xt_now() < t0 + delay_ns + c * gap_ns) {}
+        __syncthreads();
+        for (int p = 0; p < f.nr; ++p)
+        {
+            if (p == f.rank) continue;
+            uint4* dst = reinterpret_cast<uint4*>(const_cast<char*>(glue::peer_slot(f, STEP, c, p)));
+            const uint4* src = reinterpret_cast<const uint4*>(stage + ((size_t)c * f.nr + p) * bytes);
+            for (size_t i = threadIdx.x; i < bytes / 16; i += blockDim.x) dst[i] = src[i];
+        }
+        __threadfence_system();
+        __syncthreads();
+        if (threadIdx.x == 0)
+        {
+            const u64 seq = g6::coll_seq(STEP, c, f.ncoll);
+            for (int p = 0; p < f.nr; ++p)
+                if (p != f.rank) glue::st_release_sys(reinterpret_cast<u64*>(const_cast<char*>(glue::peer_slot(f, STEP, c, p)) + bytes), seq);
+            rel[c] = glue::xt_now();
+        }
+    }
+}
+
+// host view of glue::peer_slot at STEP: rank p's slot of collective c (our send slot for p == rank)
+static char* hslot(const g6::FabricDev& f, int c, int p)
+{
+    return p == f.rank ? f.send + ((size_t)(STEP & 1) * f.ncoll + c) * f.stride
+                       : f.recv + (((size_t)(STEP & 1) * f.ncoll + c) * f.nr + p) * f.stride;
+}
+
+struct Rig
+{
+    int ncoll = 0;
+    size_t stride = 0;
+    g6::FabricDev f{};
+    char *send = nullptr, *recv = nullptr;       // pinned
+    char* stage = nullptr;                       // device: [ncoll][NR][MX * HID] bf16, the peers' payloads
+    u64* stepp = nullptr;
+    float *resid = nullptr, *resid0 = nullptr;
+    __nv_bfloat16* w = nullptr;                  // [ncoll][HID]
+    __half* out = nullptr;                       // [ncoll][MX][HID]
+    u32 *xf16 = nullptr, *xbf16 = nullptr;       // [ncoll][tiles(MX)][XFW]
+    unsigned long long *xt = nullptr, *rel = nullptr;
+    unsigned* err = nullptr;                     // pinned
+    size_t xfn() const { return (size_t)g6mx::tiles(MXR) * XFW; }
+};
+
+static std::vector<__nv_bfloat16> rnd_bf16(size_t n, std::mt19937& g, float mean, float sd)
+{
+    std::normal_distribution<float> d(mean, sd);
+    std::vector<__nv_bfloat16> v(n);
+    for (auto& x : v) x = __float2bfloat16(d(g));
+    return v;
+}
+
+static void build(Rig& r, int layers)
+{
+    r.ncoll = 2 * layers;
+    r.stride = ((size_t)MXR * HID * 2 + 8 + 255) & ~size_t(255);
+    CK(cudaHostAlloc((void**)&r.send, 2 * r.ncoll * r.stride, cudaHostAllocMapped));
+    CK(cudaHostAlloc((void**)&r.recv, 2 * (size_t)r.ncoll * NR * r.stride, cudaHostAllocMapped));
+    CK(cudaHostAlloc((void**)&r.err, 4, cudaHostAllocMapped));
+    memset(r.send, 0, 2 * r.ncoll * r.stride);
+    memset(r.recv, 0, 2 * (size_t)r.ncoll * NR * r.stride);
+    *r.err = 0;
+    r.f.send = r.send; r.f.recv = r.recv; r.f.doorbell = nullptr; r.f.error = r.err;
+    r.f.rank = 0; r.f.nr = NR; r.f.ncoll = r.ncoll; r.f.stride = r.stride; r.f.xt = nullptr;
+    std::mt19937 g(1234);
+    const size_t pay = (size_t)MXR * HID;
+    CK(cudaMalloc(&r.stage, (size_t)r.ncoll * NR * pay * 2));
+    for (int c = 0; c < r.ncoll; ++c)
+        for (int p = 0; p < NR; ++p)
+        {
+            const auto v = rnd_bf16(pay, g, 0.f, 0.5f);
+            if (p == 0) memcpy(hslot(r.f, c, 0), v.data(), pay * 2);   // own: the send slot
+            CK(cudaMemcpy(r.stage + ((size_t)c * NR + p) * pay * 2, v.data(), pay * 2, cudaMemcpyHostToDevice));
+        }
+    CK(cudaMalloc(&r.stepp, 8));
+    CK(cudaMemcpy(r.stepp, &STEP, 8, cudaMemcpyHostToDevice));
+    std::vector<float> res(pay);
+    std::normal_distribution<float> d(0.f, 1.f);
+    for (auto& x : res) x = d(g);
+    CK(cudaMalloc(&r.resid, pay * 4));
+    CK(cudaMalloc(&r.resid0, pay * 4));
+    CK(cudaMemcpy(r.resid0, res.data(), pay * 4, cudaMemcpyHostToDevice));
+    const auto wv = rnd_bf16((size_t)r.ncoll * HID, g, 1.f, 0.1f);
+    CK(cudaMalloc(&r.w, wv.size() * 2));
+    CK(cudaMemcpy(r.w, wv.data(), wv.size() * 2, cudaMemcpyHostToDevice));
+    CK(cudaMalloc(&r.out, (size_t)r.ncoll * pay * 2));
+    CK(cudaMalloc(&r.xf16, (size_t)r.ncoll * r.xfn() * 4));
+    CK(cudaMalloc(&r.xbf16, (size_t)r.ncoll * r.xfn() * 4));
+    CK(cudaMalloc(&r.xt, (size_t)g6::XT_STEPS * r.ncoll * g6::XT_W * 8));
+    CK(cudaMalloc(&r.rel, (size_t)r.ncoll * 8));
+}
+
+// ready: every peer slot holds its payload and tail; late: 0xff payloads, no tails (the writer lands them)
+static void slots(Rig& r, int M, bool ready)
+{
+    const size_t bytes = (size_t)M * HID * 2;
+    for (int c = 0; c < r.ncoll; ++c)
+        for (int p = 1; p < NR; ++p)
+        {
+            char* s = hslot(r.f, c, p);
+            if (ready) CK(cudaMemcpy(s, r.stage + ((size_t)c * NR + p) * (size_t)MXR * HID * 2, bytes, cudaMemcpyDeviceToHost));
+            else memset(s, 0xff, bytes);
+            *reinterpret_cast<volatile u64*>(s + bytes) = ready ? g6::coll_seq(STEP, c, r.ncoll) : 0;
+        }
+}
+
+// the consume chain as launch_consume runs it: v = 0 split (k_wait_peers + k_ar_add_norm), 1 / 2 the fold
+static void chain(Rig& r, int v, int M, cudaStream_t st)
+{
+    for (int c = 0; c < r.ncoll; ++c)
+    {
+        glue::ArNormArgs a{r.f, r.stepp, c, M, r.resid, r.w + (size_t)c * HID, r.out + (size_t)c * MXR * HID, glue::RMS_EPS};
+#ifdef DEC_SLOT
+        a.xf16 = r.xf16 + (size_t)c * r.xfn();
+        a.xbf16 = r.xbf16 + (size_t)c * r.xfn();
+#endif
+        if (v == 0)
+        {
+            glue::k_wait_peers<<<1, 32, 0, st>>>(r.f, r.stepp, c, (size_t)M * HID * 2, glue::ERR_AR);
+            glue::k_ar_add_norm<<<dim3(glue::RN_CL, M), glue::RN_T, 0, st>>>(a);
+        }
+        else if (v == 1) glue::k_ar_wait_add_norm<1><<<dim3(glue::RN_CL, M), glue::RN_T, 0, st>>>(a);
+        else glue::k_ar_wait_add_norm<2><<<dim3(glue::RN_CL, M), glue::RN_T, 0, st>>>(a);
+    }
+}
+
+struct Out
+{
+    std::vector<char> resid, out, xf16, xbf16;
+    bool operator==(const Out& o) const { return resid == o.resid && out == o.out && xf16 == o.xf16 && xbf16 == o.xbf16; }
+};
+static void reset(Rig& r, cudaStream_t st)
+{
+    CK(cudaMemcpyAsync(r.resid, r.resid0, (size_t)MXR * HID * 4, cudaMemcpyDeviceToDevice, st));
+    CK(cudaMemsetAsync(r.out, 0, (size_t)r.ncoll * MXR * HID * 2, st));
+    CK(cudaMemsetAsync(r.xf16, 0, (size_t)r.ncoll * r.xfn() * 4, st));
+    CK(cudaMemsetAsync(r.xbf16, 0, (size_t)r.ncoll * r.xfn() * 4, st));
+    CK(cudaStreamSynchronize(st));
+}
+static Out fetch(Rig& r, int M)
+{
+    Out o;
+    auto get = [](std::vector<char>& v, const void* p, size_t n) { v.resize(n); CK(cudaMemcpy(v.data(), p, n, cudaMemcpyDeviceToHost)); };
+    get(o.resid, r.resid, (size_t)M * HID * 4);
+    o.out.clear();
+    for (int c = 0; c < r.ncoll; ++c)
+    {
+        std::vector<char> t;
+        get(t, r.out + (size_t)c * MXR * HID, (size_t)M * HID * 2);
+        o.out.insert(o.out.end(), t.begin(), t.end());
+    }
+    get(o.xf16, r.xf16, (size_t)r.ncoll * r.xfn() * 4);
+    get(o.xbf16, r.xbf16, (size_t)r.ncoll * r.xfn() * 4);
+    return o;
+}
+
+static std::vector<int> ints(const char* s)
+{
+    std::vector<int> v;
+    for (const char* p = s; *p;)
+    {
+        v.push_back(atoi(p));
+        while (*p && *p != ',') ++p;
+        if (*p) ++p;
+    }
+    return v;
+}
+
+int main(int argc, char** argv)
+{
+    std::vector<int> Ms = {1, 3, 4, 8};
+    int layers = 78, reps = 50;
+    double gap_us = 20;
+    bool check = true, bench = true;
+    for (int i = 1; i < argc; ++i)
+    {
+        const std::string a = argv[i];
+        if (a == "--M" && i + 1 < argc) Ms = ints(argv[++i]);
+        else if (a == "--layers" && i + 1 < argc) layers = atoi(argv[++i]);
+        else if (a == "--reps" && i + 1 < argc) reps = atoi(argv[++i]);
+        else if (a == "--gap-us" && i + 1 < argc) gap_us = atof(argv[++i]);
+        else if (a == "--check-only") bench = false;
+        else if (a == "--bench-only") check = false;
+        else { printf("usage: ar_fold_test [--M 1,3,4,8] [--layers 78] [--reps 50] [--gap-us 20] [--check-only] [--bench-only]\n"); return 2; }
+    }
+    for (int M : Ms)
+        if (M < 1 || M > MXR) { printf("M must be 1..%d\n", MXR); return 2; }
+    if (layers < 1 || reps < 1 || gap_us < 1) { printf("bad --layers / --reps / --gap-us\n"); return 2; }
+    Rig r;
+    build(r, layers);
+    cudaStream_t st, wst;
+    CK(cudaStreamCreateWithFlags(&st, cudaStreamNonBlocking));
+    CK(cudaStreamCreateWithFlags(&wst, cudaStreamNonBlocking));
+    int fails = 0;
+    const char* name[3] = {"split", "fold1", "fold2"};
+    printf("# ar_fold_test: NR %d, MX %d, %d consumes per chain (%d layers)\n", NR, MXR, r.ncoll, layers);
+    // the late run of variant v: the chain as one graph on st, the writer on wst; latency per consume from the stamps
+    auto late = [&](int v, int M, double* mean, double* med) {
+        slots(r, M, false);
+        reset(r, st);
+        CK(cudaMemset(r.xt, 0, (size_t)g6::XT_STEPS * r.ncoll * g6::XT_W * 8));
+        r.f.xt = r.xt;
+        cudaGraph_t g;
+        cudaGraphExec_t ge;
+        CK(cudaStreamBeginCapture(st, cudaStreamCaptureModeThreadLocal));
+        chain(r, v, M, st);
+        CK(cudaStreamEndCapture(st, &g));
+        CK(cudaGraphInstantiate(&ge, g, 0));
+        CK(cudaGraphLaunch(ge, st));
+        k_writer<<<1, 256, 0, wst>>>(r.f, M, r.stage, 200000ull, (unsigned long long)(gap_us * 1000), r.rel);
+        CK(cudaGetLastError());
+        CK(cudaStreamSynchronize(wst));
+        CK(cudaStreamSynchronize(st));
+        r.f.xt = nullptr;
+        CK(cudaGraphExecDestroy(ge));
+        CK(cudaGraphDestroy(g));
+        std::vector<unsigned long long> xt((size_t)g6::XT_STEPS * r.ncoll * g6::XT_W), rel(r.ncoll);
+        CK(cudaMemcpy(xt.data(), r.xt, xt.size() * 8, cudaMemcpyDeviceToHost));
+        CK(cudaMemcpy(rel.data(), r.rel, rel.size() * 8, cudaMemcpyDeviceToHost));
+        std::vector<double> d;
+        for (int c = 0; c < r.ncoll; ++c)
+        {
+            const unsigned long long red = xt[((STEP % g6::XT_STEPS) * r.ncoll + c) * g6::XT_W + g6::XT_RED];
+            d.push_back(((double)red - (double)rel[c]) / 1000.0);
+        }
+        double s = 0;
+        for (double x : d) s += x;
+        *mean = s / d.size();
+        std::sort(d.begin(), d.end());
+        *med = d[d.size() / 2];
+    };
+    if (check)
+        for (int M : Ms)
+        {
+            slots(r, M, true);
+            reset(r, st);
+            chain(r, 0, M, st);
+            CK(cudaStreamSynchronize(st));
+            const Out ref = fetch(r, M);
+            bool finite = true;
+            for (size_t i = 0; i < ref.resid.size(); i += 4) { float x; memcpy(&x, &ref.resid[i], 4); finite &= std::isfinite(x); }
+            for (int v = 0; v < 3; ++v)
+            {
+                slots(r, M, true);
+                reset(r, st);
+                chain(r, v, M, st);
+                CK(cudaStreamSynchronize(st));
+                const bool ok_ready = fetch(r, M) == ref && *r.err == 0;
+                double mean = 0, med = 0;
+                late(v, M, &mean, &med);
+                const bool ok_late = fetch(r, M) == ref && *r.err == 0;
+                printf("CHECK M %d %s: ready %s, late %s%s\n", M, name[v], ok_ready ? "IDENTICAL" : "DIFFERENT", ok_late ? "IDENTICAL" : "DIFFERENT",
+                       *r.err ? " (error word set)" : "");
