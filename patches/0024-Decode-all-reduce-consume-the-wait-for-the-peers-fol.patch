+        for (int M : Ms)
+        {
+            slots(r, M, true);
+            cudaGraphExec_t ge[3];
+            for (int v = 0; v < 3; ++v)
+            {
+                cudaGraph_t g;
+                CK(cudaStreamBeginCapture(st, cudaStreamCaptureModeThreadLocal));
+                chain(r, v, M, st);
+                CK(cudaStreamEndCapture(st, &g));
+                CK(cudaGraphInstantiate(&ge[v], g, 0));
+                CK(cudaGraphDestroy(g));
+            }
+            cudaEvent_t e0, e1;
+            CK(cudaEventCreate(&e0));
+            CK(cudaEventCreate(&e1));
+            std::vector<double> t[3];
+            for (int s = 0; s < 6; ++s)
+                for (int v = 0; v < 3; ++v)
+                {
+                    reset(r, st);
+                    CK(cudaEventRecord(e0, st));
+                    for (int k = 0; k < reps; ++k) CK(cudaGraphLaunch(ge[v], st));
+                    CK(cudaEventRecord(e1, st));
+                    CK(cudaEventSynchronize(e1));
+                    float ms = 0;
+                    CK(cudaEventElapsedTime(&ms, e0, e1));
+                    if (s) t[v].push_back(1000.0 * ms / reps / r.ncoll);   // sample 0 warms up
+                }
+            double med[3];
+            for (int v = 0; v < 3; ++v) { std::sort(t[v].begin(), t[v].end()); med[v] = t[v][t[v].size() / 2]; }
+            printf("BENCH ready M %d: us per consume split %.3f fold1 %.3f fold2 %.3f; per step (%d consumes) fold1 %+.3f ms, fold2 %+.3f ms\n",
+                   M, med[0], med[1], med[2], r.ncoll, (med[1] - med[0]) * r.ncoll / 1000.0, (med[2] - med[0]) * r.ncoll / 1000.0);
+            double lm[3], ld[3];
+            for (int v = 0; v < 3; ++v) late(v, M, &lm[v], &ld[v]);
+            printf("BENCH late M %d (gap %.0f us): last tail -> reduce end, mean / median us: split %.3f / %.3f fold1 %.3f / %.3f fold2 %.3f / %.3f; "
+                   "per step fold1 %+.3f ms, fold2 %+.3f ms (means)\n", M, gap_us, lm[0], ld[0], lm[1], ld[1], lm[2], ld[2],
+                   (lm[1] - lm[0]) * r.ncoll / 1000.0, (lm[2] - lm[0]) * r.ncoll / 1000.0);
+            for (int v = 0; v < 3; ++v) CK(cudaGraphExecDestroy(ge[v]));
+            CK(cudaEventDestroy(e0));
+            CK(cudaEventDestroy(e1));
+        }
+    if (check) printf("ar_fold_test: %s\n", fails ? "FAIL" : "PASS");
+    return fails ? 1 : 0;
+}
