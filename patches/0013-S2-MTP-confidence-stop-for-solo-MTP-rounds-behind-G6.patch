+        CHECK(i < (int)f.trace.size() && std::get<1>(f.trace[i]) == 2 * 3);
+        for (int r = 0; r < 20; ++r) CHECK(b.round({0, 1}));
+        CHECK(b.stats(0).acc[2] > 0);
+    }
