+            f.dright_at = [](int q0) { return (unsigned)(q0 * 2654435761u) >> 28 < 3 ? 5 : 1; };   // 3 in 16 blocks 5 right
+            Batch b(2, 32, f.hooks());
+            b.dflash(7, g6rt::SpecLen());
+            DSel sel = dsel(1, table(arm ? withr.c_str() : M0));
+            sel.probe = 32;
+            b.dsel(sel);
+            b.kstop(kstop3());
+            b.admit({0}, {session()});
+            for (int i = 0; i < 600; ++i) CHECK(b.round({0}));
