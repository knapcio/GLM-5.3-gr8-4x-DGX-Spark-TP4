# Copy to docker/.env in a gr8 checkout (next to upstream's docker/compose.yaml) on every box; the same file on every
# box. Compose passes each line into the container, where the launcher reads it as an option (upstream KNOBS.md and
# docs/SETTINGS.md list every option and its default). Values in <ANGLE_BRACKETS> are placeholders.

# --- the model -------------------------------------------------------------------------------------------------------
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4
# The DFlash2 drafter (CC BY-NC-ND 4.0, noncommercial): each box downloads and converts its own copy; nothing is
# redistributed here, and converting it locally does not lift the noncommercial restriction.
DRAFTER=https://huggingface.co/incoai/GLM-5.3-DFlash2
# The measurements use the default width manifest at TP=4 (home); leave VARIANT unset.
#VARIANT=home
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- the boxes -------------------------------------------------------------------------------------------------------
# The LAN address of every box, in rank order, the same line on every box. The first is the head (OpenAI API on
# 0.0.0.0:8100, no authentication: trusted network or firewall only, never forwarded on a public router).
PEERS=<PEER0_IP>,<PEER1_IP>,<PEER2_IP>,<PEER3_IP>

# --- the container ---------------------------------------------------------------------------------------------------
# Read by compose. GR8_IMAGE is the image built from this recipe's Dockerfile, the same tag on every box.
GR8_IMAGE=gr8-glm53-recipe:v0.4
# Host directories owned by uid 1000 (create them first: sudo mkdir -p DIR && sudo chown 1000:1000 DIR; Docker would
# create a missing one owned by root and the container refuses it): this box's part of the model (~90 GB at TP=4), and
# logs/state. Leave both unset to use Docker named volumes.
GR8_CACHE=<GR8_CACHE_DIR>
GR8_HOME=<GR8_HOME_DIR>

# --- this recipe's engine flags --------------------------------------------------------------------------------------
# Every box must carry the same line: the split flags add collectives, so ranks with different flags cannot boot together.
# NEVER add G6_ATTN_P11=1: it takes precedence over G6_ATTN_SC2 / G6_ATTN_CTX2 / G6_ATTN_CTX3 and silently replaces the
# attention kernels this recipe measured.
# G6_S2_DSEL_TABLE is the drafter choice's cost table, in milliseconds measured on the recipe's four boxes with
# tools/s2_dsel_table.py (README, Reproducing, "DSel cost table"). On other hardware measure it again; every box must
# carry the same table.
G6ENV_X="G6_QA_SPLIT=1 G6_IDXQ_SPLIT=1 G6_MTP_SPLIT=1 G6_DRAFT_HEAD_I4=1 G6_DFL_HEAD_I4=1 G6_S2_DSEL_PROBE=32 G6_ROUTE_OVL=1 G6_ATTN_SC2=4 G6_ATTN_SC2_TR=2 G6_ATTN_CTX2=4 G6_ATTN_CTX3=2 G6_ATTN_SEL2=16 G6_IDX_GRP=16 G6_MTP_KSTOP=1 G6_MTP_KSTOP_KMAX=3 G6_MTP_KSTOP_TAU=0,0.5,0.75 G6_DFL_REUSE=2 G6_ATTN_QT=1 G6_ATTN_FRONT=1 G6_DRAFT_PAR=1 G6_S2_DSEL_MODEL=1 G6_S2_DSEL_TABLE=v2:46.63,v3:54.71,v4:63.99,v5:71.54,v6:79.37,v7:88.23,v8:96.82,d:7.285,m:2.039,e:1.155,p:5.026,g:1.107,k:2.177,n:2.486,w:1,r:0.95 G6_DFL_BODY_I4=1"
